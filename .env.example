NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Signed presets should enforce allowed_formats=jpg,png,webp, max_file_size=5242880,
# unique_filename=true and disallow_public_id=true in Cloudinary.
CLOUDINARY_ADMIN_UPLOAD_PRESET=
CLOUDINARY_REGISTRATION_UPLOAD_PRESET=

# Cloudflare Turnstile (server validation is mandatory in production).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=

# Server-only. Enables durable distributed upload rate limiting; never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# CI/production operations (store as deployment or GitHub secrets, never NEXT_PUBLIC_)
PRODUCTION_URL=
SUPABASE_DB_URL=
BACKUP_ENCRYPTION_KEY=
MONITOR_ALERT_WEBHOOK=
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
# Optional local/CI Playwright credentials. Use a dedicated non-production admin.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_ORGANIZER_EMAIL=
E2E_ORGANIZER_PASSWORD=
E2E_SCORER_EMAIL=
E2E_SCORER_PASSWORD=
E2E_SUPABASE_SERVICE_ROLE_KEY=
E2E_RUN_FULL=false
# Optional stable match used for read-only scorer verification.
E2E_MATCH_ID=
