{
  "id": "/en",
  "name": "CrickPulse Cricket Scoring",
  "short_name": "CrickPulse",
  "description": "Live cricket scoring, tournaments, statistics and public match centre.",
  "start_url": "/en?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#050b26",
  "theme_color": "#07162f",
